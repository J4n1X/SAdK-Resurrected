# ── Game-derived material: never commit (copyrighted) ──
# Binaries, archives, memory dumps
*.exe
*.zip
*.7z
*.bin
*.dmp
tools/procdump/
# The game's own message schema (copy it from your game's bin folder)
/lobby/sadk_lobby/data/msgdefs.ini
# Ghidra project working copies (embed the game binary)
sadk/
# Offline Ghidra exports (regeneratable)
decomp/sadk/
decomp/tincat/
*.exe.c
*.exe.h
*_functions.tsv
*_strings*.tsv
*_strings*.txt
tincat3.dll.xml

# ── Live server data: accounts, password hashes, mail (never publish) ──
/sadk_players.json*
/sadk_mail.json*
/stub*.out
/status-cur/
tincat_lobby_unhandled.log*

# ── Captures, logs, runtime artifacts ──
sadk_captures/
capture_scoped.json
*.pcapng
*.log
*.mp4
tools/*.out

# ── Mapping run: derived bulk (decompiled game code, batches, run state) ──
/mapping/cache/
/mapping/work/
/mapping/queue/
/mapping/dumps/
/mapping/rebase/
/mapping/state.db*

# ── Python ──
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
.venv-pypy/

# ── Local agent state ──
.claude/

# ── Assembled GitHub release (packaging/make_release.sh) ──
/release/
