#include <windows.h>
#include "resource.h"

IDI_APP  ICON   "sadk.ico"
IDR_SHIM RCDATA "../wsock32_shim/wsock32.dll"
1        24     "serverconfig.manifest"

IDD_MAIN DIALOGEX 0, 0, 260, 250
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "SAdK-ServerConfig"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Game folder", -1, 7, 7, 246, 60
    EDITTEXT        IDC_FOLDER, 14, 20, 206, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 224, 20, 22, 14
    LTEXT           "", IDC_STATUS, 14, 38, 232, 9
    LTEXT           "", IDC_MODWARN, 14, 48, 232, 17

    GROUPBOX        "Lobby server", -1, 7, 72, 246, 78
    LTEXT           "Host", -1, 14, 87, 30, 9
    EDITTEXT        IDC_HOST, 50, 85, 196, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Advanced configuration", IDC_ADVANCED, 14, 104, 120, 10
    LTEXT           "Lobby port", IDC_L_LOBBYPORT, 24, 120, 40, 9
    EDITTEXT        IDC_LOBBYPORT, 68, 118, 40, 14, ES_NUMBER
    LTEXT           "Game port", IDC_L_GAMEPORT, 132, 120, 40, 9
    EDITTEXT        IDC_GAMEPORT, 176, 118, 40, 14, ES_NUMBER
    LTEXT           "Bridge port", IDC_L_BRIDGEPORT, 24, 136, 40, 9
    EDITTEXT        IDC_BRIDGEPORT, 68, 134, 40, 14, ES_NUMBER

    GROUPBOX        "Bridge", -1, 7, 155, 246, 40
    AUTOCHECKBOX    "Always host through the bridge (ForceBridge)", IDC_FORCE, 14, 168, 220, 10
    LTEXT           "", IDC_SHIM, 14, 181, 232, 9

    GROUPBOX        "Lobby world", -1, 7, 200, 246, 26
    AUTOCHECKBOX    "Disable billboards (the advertising pages are gone)", IDC_BILLBOARDS, 14, 211, 230, 10

    DEFPUSHBUTTON   "Save", IDOK, 146, 230, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 203, 230, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SAdK-ServerConfig"
            VALUE "ProductName", "Die Siedler - Auferstehung der Kulturen"
            VALUE "FileVersion", "1.0"
            VALUE "OriginalFilename", "SAdK-ServerConfig.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
